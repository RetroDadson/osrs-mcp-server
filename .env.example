PG_USER=postgres # This can be anything if using docker-compose, otherwise match it with the user in your external DB.
PG_PASSWORD=postgres # This can be anything if using docker-compose, otherwise match it with the password in your external DB.
PG_HOST=postgres # Only change this if you are connecting to an external postgres database.
PG_PORT=5432 # Only change this if you are connecting to an external postgres database on a non-standard port.
PG_DB=osrsmcp # This can be anything if using docker-compose, otherwise match it with the database name in your external DB.
AUTH_SECRET=somerandomkey # Generate a random secret - used to hash login tokens (HMAC-SHA256 key). Rotating this invalidates every existing login token.
PORT=8080 # Port the single app process (API + MCP + static frontend) listens on.
LOG_LEVEL=info # info | warn | error | debug
HCAPTCHA_ENABLED=false # Set to true to require hCaptcha on login creation.
HCAPTCHA_SITEKEY= # Required if HCAPTCHA_ENABLED=true.
HCAPTCHA_SECRET= # Required if HCAPTCHA_ENABLED=true.
